# =============================================================================
# ABot-Claw 全局配置文件
# 用途：集中管理网口名称、代理、路径等可配置项
# 使用方式：在启动脚本中 source 此文件，或 export 相关环境变量
#
# 换机器时只需修改本文件中的「机器配置」区域即可
# =============================================================================

# ---------------------------------------------------------------------------
# 机器配置（必须按实际修改）
# ---------------------------------------------------------------------------
# 网络接口：填入 G1 机器人连接到的网卡名（ip link show 查看）
# ---------------------------------------------------------------------------
G1_IFACE="eth0"

# ---------------------------------------------------------------------------
# Conda 环境根目录
# ---------------------------------------------------------------------------
CONDA_ROOT="${HOME}/miniconda3"
CONDA_ENV="g1_agent"

# ---------------------------------------------------------------------------
# CycloneDDS 安装路径（源码编译后放在项目外的 cyclonedds/install）
# ---------------------------------------------------------------------------
CYCLONEDDS_ROOT="${HOME}/cyclonedds/install"

# ---------------------------------------------------------------------------
# 项目根目录（config.env 所在目录）
# ---------------------------------------------------------------------------
PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export PROJECT_ROOT

# ---------------------------------------------------------------------------
# 网络接口配置（G1 机器人通信用）
# ---------------------------------------------------------------------------
export UNITREE_IFACE="${G1_IFACE}"
export G1_NETWORK_INTERFACE="${G1_IFACE}"
export G1_ARM_NETWORK_INTERFACE="${G1_IFACE}"
export G1_ARM_NETWORK_IFACE="${G1_IFACE}"

# ---------------------------------------------------------------------------
# Livox MID360 LiDAR 网络配置（rviz_MID360_launch.py 会自动读取并注入 JSON）
# ---------------------------------------------------------------------------
# LIVOX_HOST_IP: 接收雷达数据的本机 IP（须与实际网卡 IP 一致）
# LIVOX_LIDAR_IP: Livox MID360 雷达自身的 IP
# ---------------------------------------------------------------------------
export LIVOX_HOST_IP="192.168.123.164"
export LIVOX_LIDAR_IP="192.168.123.120"

# ---------------------------------------------------------------------------
# 机器人 / 相机 IP 配置（统一用 G1_ROBOT_IP 作为主入口；其余 IP 均引用它）
# ---------------------------------------------------------------------------
# G1_ROBOT_IP:  机器人本体 IP（D455 ZMQ 推流、灵巧手 TCP、D435i TCP 均用此 IP）
# D435I_HOST:   D435i TCP 深度推流主机（缺省等于 G1_ROBOT_IP）
# D455_HOST:    D455 RGBD 相机 IP（缺省等于 G1_ROBOT_IP）
# FACE_CAMERA_HOST: 人脸识别时请求的相机主机（缺省等于 G1_ROBOT_IP）
# ---------------------------------------------------------------------------
export G1_ROBOT_IP="192.168.123.164"
export D435I_HOST="${G1_ROBOT_IP}"
export D455_HOST="${G1_ROBOT_IP}"
export FACE_CAMERA_HOST="${G1_ROBOT_IP}"

# ---------------------------------------------------------------------------
# Agent Server / 本机 IP 配置（agent server 运行在本机，供外部调用）
# ---------------------------------------------------------------------------
export AGENT_SERVER_HOST="192.168.123.164"

# ---------------------------------------------------------------------------
# CycloneDDS 配置（unitree_sdk2py 依赖）
# 安装在 g1_agent conda 环境中
# ---------------------------------------------------------------------------
export CYCLONEDDS_HOME="${PROJECT_ROOT}/unitree_sdk2_python/cyclonedds/install"
export LD_LIBRARY_PATH="${CYCLONEDDS_HOME}/lib:${LD_LIBRARY_PATH:-}"

# ---------------------------------------------------------------------------
# unitree_sdk2py Python 路径（本地源码，无需 pip install）
# ---------------------------------------------------------------------------
export PYTHONPATH="${PROJECT_ROOT}/unitree_sdk2_python:${PYTHONPATH:-}"

# ---------------------------------------------------------------------------
# 网络代理（模型首次下载需要；无需代理时可注释掉）
# ---------------------------------------------------------------------------
# export https_proxy="http://127.0.0.1:7897"
# export http_proxy="http://127.0.0.1:7897"
# export all_proxy="socks5://127.0.0.1:7897"

# ---------------------------------------------------------------------------
# GraspAnything 路径配置
# ---------------------------------------------------------------------------
export ANYGRASP_SDK_PATH="${PROJECT_ROOT}/Services/GraspAnything/anygrasp_sdk"
export GRASP_CHECKPOINT_PATH="${ANYGRASP_SDK_PATH}/grasp_detection/log/checkpoint_detection.tar"
export GRASP_YOLO_MODEL_PATH="${PROJECT_ROOT}/Services/YOLO/yolov5l6.pt"
export ANYGRASP_PYTHON="${CONDA_ROOT}/envs/anygrasp/bin/python"

# ---------------------------------------------------------------------------
# YOLO 模型路径
# ---------------------------------------------------------------------------
export YOLO_MODEL_PATH="${PROJECT_ROOT}/Services/YOLO/yolov5l6.pt"

# ---------------------------------------------------------------------------
# robot_driver_ros 路径（供 lightning/定位 launch 文件使用）
# ---------------------------------------------------------------------------
export ROBOT_DRIVER_ROS_ROOT="${PROJECT_ROOT}/robot_client/unitree_G1/agent_server/robot_driver_ros"
export LIGHTNING_MAP_PATH="${ROBOT_DRIVER_ROS_ROOT}/src/lightning/data/new_map/"

# ---------------------------------------------------------------------------
# SpatialMemory 数据库路径
# ---------------------------------------------------------------------------
export SPATIAL_MEMORY_DB="${PROJECT_ROOT}/Services/SpatialMemory/data/memory_hub.db"